# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
.vite/

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── TypeScript build info ─────────────────────────────────────────────────────
*.tsbuildinfo

# ── Supabase local ────────────────────────────────────────────────────────────
supabase/.temp/
supabase/.branches/
supabase/.env

# ── Deno cache files (created by `deno check` in supabase/functions/) ─────────
# These are SQLite databases that confuse the Supabase CLI deploy when present.
supabase/functions/check_cache_v2
supabase/functions/check_cache_v2-*
supabase/functions/dep_analysis_cache_v2
supabase/functions/dep_analysis_cache_v2-*
supabase/functions/fast_check_cache_v2
supabase/functions/node_analysis_cache_v2
supabase/functions/v8_code_cache_v2

# ── Local dev router (edge runtime only, not for version control) ─────────────
supabase/functions/_router/
